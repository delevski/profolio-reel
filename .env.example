# Site
NEXT_PUBLIC_SITE_URL=https://ordelwebsite.vercel.app

# Supabase (site reads with anon key; pipeline uses service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Daily trends pipeline (GitHub Actions secrets — do not commit real values)
MISTRAL_API_KEY=
RESEND_API_KEY=
DIGEST_EMAIL=ordi21@walla.co.il
RESEND_FROM="AI Trends Digest <onboarding@resend.dev>"

# Smart agent widget (/api/agent) - OpenRouter free tier, server-side only.
# Get a free key at https://openrouter.ai/keys and add it in Vercel project settings.
# Without it the widget still works, answering curated recruiter FAQ from site content.
OPENROUTER_API_KEY=
# Optional: override the free model used by the agent
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
